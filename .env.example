# Copy this file to .env and fill in real values. .env is gitignored.

# Required for Claude scoring + translation calls (server/scoring.ts, server/translate.ts).
ANTHROPIC_API_KEY=

# Port the Express API listens on. Vite proxies /api and /uploads to this.
# NOT named PORT on purpose — some dev launchers inject PORT for the main
# (Vite) dev server, and that would collide with this one.
API_PORT=8787

# Passphrase for the officer console demo login. Defaults to "canopy" if unset.
OFFICER_PASSPHRASE=

# --- Production only (Vercel) — leave blank for local dev ---

# Set automatically by Vercel's Neon integration (Storage tab). When unset,
# the app falls back to embedded PGlite for zero-setup local dev — PGlite
# cannot run on Vercel itself (see docs/deploy-vercel.md).
DATABASE_URL=

# Set automatically when you create a Blob store in the Vercel dashboard
# (Storage tab). When unset, uploaded photos are written to server/uploads/
# on local disk instead — that only works for local dev, not on Vercel.
BLOB_READ_WRITE_TOKEN=
