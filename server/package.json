    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.2",
